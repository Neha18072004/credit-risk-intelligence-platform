# ---- Data: never commit the Home Credit dataset ----
data/*
!data/sample/
!data/sample/**
!data/.gitkeep

# ---- Model artifacts ----
models/*
!models/.gitkeep

# ---- Generated reports (figures are regenerated by the EDA step) ----
reports/*
!reports/.gitkeep

# ---- Secrets ----
.env
.env.local
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.python-version

# ---- Tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
.DS_Store

# ---- Jupyter ----
notebooks/.ipynb_checkpoints/

# ---- Streamlit ----
.streamlit/secrets.toml

# EDA artifacts are regenerated by `python -m notebooks.eda`; figures are
# committed so the README and UI render without a training run.
!reports/figures/*.png
