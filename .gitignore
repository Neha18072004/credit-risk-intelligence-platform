# ---- Data: never commit the Home Credit dataset ----
data/*
!data/sample/
!data/sample/**
!data/.gitkeep

# ---- Model artifacts ----
models/*
!models/.gitkeep

# ---- Generated reports ----
# Metrics and CSVs are regenerated by the pipeline and stay out of git. The
# figures ARE committed: the README embeds them, the presentation uses them,
# and someone browsing the repo should see the analysis without running
# anything. Note the directory has to be un-ignored before a rule can match
# files inside it -- git does not descend into an excluded directory, which is
# why an earlier `!reports/figures/*.png` on its own did nothing.
reports/*
!reports/.gitkeep
!reports/figures/
reports/figures/*
!reports/figures/*.png
!reports/figures/.gitkeep

# ---- Secrets ----
.env
.env.local
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.python-version

# ---- Tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
.DS_Store

# ---- Jupyter ----
notebooks/.ipynb_checkpoints/

# ---- Streamlit ----
.streamlit/secrets.toml
