# ===========================================================================
# Credit Risk Intelligence Platform - environment template
# Copy to `.env` and fill in.  `.env` is gitignored and never committed.
#   cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Credit Risk Intelligence Platform"
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------------------
# Data source
#   DATA_MODE=sample -> reads the committed synthetic fixtures in data/sample/
#   DATA_MODE=real   -> reads the real Home Credit CSVs from DATA_DIR
# The pipeline is identical in both modes; only the file paths change.
# ---------------------------------------------------------------------------
DATA_MODE=sample
DATA_DIR=./data                  # real Home Credit CSVs are mounted here
SAMPLE_DATA_DIR=./data/sample
MODELS_DIR=./models
REPORTS_DIR=./reports

# Optional row cap when reading the real 307k-row files (0 = no limit).
# Useful for a fast smoke run on a laptop.
MAX_ROWS=0

# ---------------------------------------------------------------------------
# Which auxiliary tables to join.
#
# Each is a flag rather than a hardcoded choice so its contribution can be
# MEASURED rather than assumed -- `python -m src.ml.ablation` switches each on
# in turn and reports the marginal gain. On the full dataset each of the three
# below adds roughly +0.007 PR-AUC, so all three earn their place.
#
# bureau_balance, POS_CASH_balance and credit_card_balance are present in the
# Kaggle download but not joined: each is a monthly panel largely redundant with
# these aggregates, and each costs real runtime.
# ---------------------------------------------------------------------------
INCLUDE_BUREAU=true                  # credit held with other institutions
INCLUDE_PREVIOUS_APPLICATION=true    # prior applications to this lender
INCLUDE_INSTALLMENTS=true            # how prior loans were actually repaid

# ---------------------------------------------------------------------------
# PostgreSQL  (docker-compose brings this up as the `db` service)
# ---------------------------------------------------------------------------
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit_pass_change_me
POSTGRES_DB=credit_risk
POSTGRES_HOST=db                 # use `localhost` when running outside Docker
POSTGRES_PORT=5432

# Read-only role used exclusively by the talk-to-data (NL->SQL) feature.
# Defence in depth: even if SQL validation were bypassed, this role cannot write.
POSTGRES_READONLY_USER=credit_readonly
POSTGRES_READONLY_PASSWORD=readonly_pass_change_me

# Set to true to fall back to a local SQLite file if Postgres is unreachable.
# Postgres is the default and the supported path.
USE_SQLITE_FALLBACK=false
SQLITE_PATH=./data/credit_risk.db

# ---------------------------------------------------------------------------
# LLM provider  (provider-agnostic; LOCAL BY DEFAULT, no API key required)
#   LLM_PROVIDER = ollama | openai | anthropic | gemini | none
#
# The default is `ollama`: the model runs locally as a docker-compose service
# next to the app, so `docker-compose up` gives you a fully working chatbot
# with ZERO credentials. Applicant data never leaves the host, which is the
# right posture for a credit-risk system handling personal financial records.
#
# The hosted providers below are OPTIONAL overrides. Selecting one without its
# key does not crash the app -- the Chat tab shows a clear message explaining
# how to fix it, and every other feature keeps working.
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama

# Default model. qwen2.5-coder:7b is chosen for text-to-SQL accuracy at 7B.
# If it cannot be pulled, the app falls back to OLLAMA_FALLBACK_MODEL.
LLM_MODEL=qwen2.5-coder:7b
LLM_TEMPERATURE=0.0              # deterministic SQL generation
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120          # local CPU inference is slower than a hosted API

# --- local runtime (used when LLM_PROVIDER=ollama) ---
# Inside docker-compose use the service name; running the app outside Docker
# against a local Ollama, use http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_FALLBACK_MODEL=llama3.1:8b
OLLAMA_KEEP_ALIVE=60m            # keep the model resident between questions.
                                 # 10m was too short: an evaluator who browses the
                                 # EDA for a quarter of an hour then asks a question
                                 # would pay the full ~70s model load again. 60m
                                 # covers any realistic session and still releases
                                 # the ~5GB eventually. Use -1 to pin it forever.

# --- optional hosted overrides (leave blank unless you want them) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Talk-to-data guardrails (hallucination + safety control)
# ---------------------------------------------------------------------------
SQL_MAX_ROWS=200                 # hard LIMIT injected into every generated query
SQL_TIMEOUT_SECONDS=15           # statement timeout on the DB side
SQL_ALLOW_ONLY_SELECT=true       # reject anything that is not a single SELECT
MEMORY_MAX_TURNS=6               # conversation turns retained for follow-ups

# ---------------------------------------------------------------------------
# ML training
# ---------------------------------------------------------------------------
RANDOM_SEED=42
CV_FOLDS=5
CALIBRATION_METHOD=isotonic      # isotonic | sigmoid
RISK_SCORE_SCALE=1000            # calibrated probability -> 0..RISK_SCORE_SCALE
RISK_BAND_LOW_MAX=0.05           # p(default) <= this  -> Low risk
RISK_BAND_MEDIUM_MAX=0.15        # p(default) <= this  -> Medium risk, else High
SURROGATE_TREE_MAX_DEPTH=4       # shallow tree used to derive IF/THEN policy rules

# Hyperparameter search. Off by default so the documented quick-start stays
# quick -- the bake-off runs in seconds without it and minutes with it. The
# shipped defaults already come from a search on the full dataset; turn this on
# to reproduce it, or after changing the feature set.
TUNE_HYPERPARAMETERS=false
TUNING_ITERATIONS=12             # parameter settings sampled per model

# ---------------------------------------------------------------------------
# Streamlit
# ---------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
